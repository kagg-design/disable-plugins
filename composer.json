{
  "name": "kagg/disable-plugins",
  "description": "MU-Plugin to disable plugins by set of rules",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "disable plugins"
  ],
  "homepage": "https://github.com/kagg-design/disable-plugins",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "KAGG Design",
      "email": "info@kagg.eu",
      "homepage": "https://kagg.eu/en/"
    }
  ],
  "support": {
    "issues": "https://github.com/kagg-design/disable-plugins/issues"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": {
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "10up/wp_mock": "0.4.2 - 1.0.1",
    "lucatume/function-mocker": "^2.0.0",
    "phpcompatibility/php-compatibility": "^9.3.5",
    "phpcompatibility/phpcompatibility-wp": "^2.1.5",
    "phpunit/phpunit": "8.5.40 - 11.5.2",
    "squizlabs/php_codesniffer": "^3.11.2",
    "wp-coding-standards/wpcs": "^3.1.0"
  },
  "autoload": {
    "psr-4": {
      "KAGG\\DisablePlugins\\": "src/php"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KAGG\\DisablePlugins\\": "src/php",
      "KAGG\\DisablePlugins\\Tests\\Unit\\": "tests/php/unit"
    }
  },
  "scripts": {
    "phpcs": "vendor/bin/phpcs --colors --standard=phpcs.xml",
    "unit": "vendor/bin/phpunit"
  }
}
